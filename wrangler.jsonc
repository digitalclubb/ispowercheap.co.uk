{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ispowercheap",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-11-01",
	// nodejs_als: SvelteKit's getRequestEvent() (used by region.ts) needs AsyncLocalStorage.
	"compatibility_flags": ["nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"routes": [
		{ "pattern": "ispowercheap.co.uk", "custom_domain": true },
		{ "pattern": "www.ispowercheap.co.uk", "custom_domain": true }
	],
	"observability": { "enabled": true }
}

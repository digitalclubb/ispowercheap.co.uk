{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ispowercheap",
	"compatibility_date": "2026-11-01",
	// nodejs_als: SvelteKit's getRequestEvent() (used by region.ts) needs AsyncLocalStorage.
	"compatibility_flags": ["nodejs_als"],
	// www -> apex is a Cloudflare Redirect Rule on the zone, not a Worker route.
	"routes": [{ "pattern": "ispowercheap.co.uk", "custom_domain": true }],
	"observability": { "enabled": true }
}
